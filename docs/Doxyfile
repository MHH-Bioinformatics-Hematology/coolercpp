# Doxygen reads the public headers and writes the XML that Breathe turns into
# the API pages. Run it from the repository root: doxygen docs/Doxyfile
PROJECT_NAME           = coolercpp
OUTPUT_DIRECTORY       = docs/_doxygen
INPUT                  = include/coolercpp
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
# Two helpers of dtype.hpp are left out of the API pages: Doxygen writes the
# constexpr constructors of Bool8 twice, and Sphinx cannot tell the template
# specializations of dtype_of apart. Both are described in the dtype header.
EXCLUDE_SYMBOLS        = coolercpp::Bool8 coolercpp::dtype_of
