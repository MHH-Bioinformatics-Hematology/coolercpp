{
 "cases": [
  {"name": "scool.S.three_cells", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"},
              "head": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 50}]},
              "tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 5}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "cell2", "pixels": "@inputs/main/pixels"},
                        {"name": "cell10", "pixels": "@inputs/head/pixels"},
                        {"name": "cell1", "pixels": "@inputs/tiny/pixels"}]}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/cell1", "@work/out.scool::/cells/cell2",
                  "@work/out.scool::/cells/cell10"]},

  {"name": "scool.S.metadata_assembly_slashed_names", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"},
              "head": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 120}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "plate/A1", "pixels": "@inputs/main/pixels"},
                        {"name": "B2", "pixels": "@inputs/head/pixels"}],
              "options": {"assembly": "dm3", "metadata": {"protocol": "in situ", "replicate": 2}}}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/A1", "@work/out.scool::/cells/B2"]},

  {"name": "scool.G.per_cell_bins_weights", "op": "create",
   "inputs": {"main": {"source": "@hicx/hicDetectLoops/GSE63525_GM12878_insitu_primary_2_5mb.cool"},
              "scaled": {"source": "@hicx/hicDetectLoops/GSE63525_GM12878_insitu_primary_2_5mb.cool",
                         "transforms": [{"op": "head", "n": 400}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "a", "pixels": "@inputs/main/pixels", "bins": "@inputs/main/bins"},
                        {"name": "b", "pixels": "@inputs/scaled/pixels", "bins": "@inputs/scaled/bins"}]}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/a", "@work/out.scool::/cells/b"]},

  {"name": "scool.S.shared_bins_keep_weight_columns", "op": "create",
   "inputs": {"main": {"source": "@hicx/hicCorrectMatrix/gm12878_KR.cool"},
              "head": {"source": "@hicx/hicCorrectMatrix/gm12878_KR.cool", "transforms": [{"op": "head", "n": 900}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "c1", "pixels": "@inputs/main/pixels"},
                        {"name": "c2", "pixels": "@inputs/head/pixels"}],
              "options": {"dtypes": {"count": "float64"}}}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/c1", "@work/out.scool::/cells/c2"]},

  {"name": "scool.S.chunked_cell_and_h5opts", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool", "chunks": 3},
              "tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 11}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "chunked", "pixel_chunks": ["@inputs/main/pixels_0", "@inputs/main/pixels_1", "@inputs/main/pixels_2"]},
                        {"name": "whole", "pixels": "@inputs/tiny/pixels"}],
              "options": {"h5opts": {"compression": "gzip", "compression_opts": 1, "shuffle": false}}}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/chunked", "@work/out.scool::/cells/whole"]},

  {"name": "scool.err.group_path_not_root", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"},
              "tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 9}]}},
   "steps": [{"uri": "@work/out.scool::/experiment", "bins": "@inputs/main/bins",
              "cells": [{"name": "x", "pixels": "@inputs/tiny/pixels"}]}]},

  {"name": "scool.S.mode_append_keeps_old_cells", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"},
              "tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 13}]}},
   "steps": [
    {"uri": "@work/out.scool", "bins": "@inputs/main/bins",
     "cells": [{"name": "first", "pixels": "@inputs/main/pixels"},
               {"name": "shared", "pixels": "@inputs/main/pixels"}]},
    {"uri": "@work/out.scool", "bins": "@inputs/main/bins",
     "cells": [{"name": "second", "pixels": "@inputs/tiny/pixels"},
               {"name": "shared", "pixels": "@inputs/tiny/pixels"}],
     "options": {"mode": "a"}}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/first", "@work/out.scool::/cells/second",
                  "@work/out.scool::/cells/shared"]},

  {"name": "scool.S.square_storage_mode", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "full_square"}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "sq", "pixels": "@inputs/main/pixels"}],
              "options": {"symmetric_upper": false}}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/cells/sq"]},

  {"name": "scool.err.bins_pixels_keys_mismatch", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "a", "pixels": "@inputs/main/pixels"},
                        {"name": "b", "pixels": "@inputs/main/pixels"}],
              "cell_bins": [{"name": "a", "bins": "@inputs/main/bins"},
                            {"name": "c", "bins": "@inputs/main/bins"}]}]},

  {"name": "scool.err.missing_bin_column", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool", "bins_columns": ["chrom", "start"]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "a", "pixels": "@inputs/main/pixels"}]}]},

  {"name": "scool.err.unknown_h5opt", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "a", "pixels": "@inputs/main/pixels"}],
              "options": {"h5opts": {"compresion": "gzip"}}}]},

  {"name": "scool.err.standard_column_missing", "op": "create",
   "inputs": {"main": {"source": "@hicx/small_test_matrix_50kb_res.cool"}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/main/bins",
              "cells": [{"name": "a", "pixels": "@inputs/main/pixels"}],
              "options": {"columns": ["count", "balanced"]}}]},

  {"name": "fileops.predicates.cool_mcool_scool", "op": "fileops",
   "inputs": {"tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 7}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/tiny/bins",
              "cells": [{"name": "c1", "pixels": "@inputs/tiny/pixels"},
                        {"name": "c2", "pixels": "@inputs/tiny/pixels"}]}],
   "calls": [
    {"fn": "is_cooler", "args": ["@cooler/toy.symm.upper.2.cool"]},
    {"fn": "is_cooler", "args": ["@cooler/toy.symm.upper.2.mcool"]},
    {"fn": "is_cooler", "args": ["@cooler/toy.symm.upper.2.mcool::/resolutions/2"]},
    {"fn": "is_cooler", "args": ["@cooler/toy.chrom.sizes"]},
    {"fn": "is_cooler", "args": ["@cooler/does_not_exist.cool"]},
    {"fn": "is_cooler", "args": ["@work/out.scool"]},
    {"fn": "is_cooler", "args": ["@work/out.scool::/cells/c1"]},
    {"fn": "is_multires_file", "args": ["@cooler/toy.symm.upper.2.mcool"]},
    {"fn": "is_multires_file", "args": ["@cooler/toy.symm.upper.2.mcool", 2]},
    {"fn": "is_multires_file", "args": ["@cooler/toy.symm.upper.2.cool"]},
    {"fn": "is_multires_file", "args": ["@cooler/toy.chrom.sizes"]},
    {"fn": "is_multires_file", "args": ["@work/out.scool"]},
    {"fn": "is_scool_file", "args": ["@cooler/toy.symm.upper.2.cool"]},
    {"fn": "is_scool_file", "args": ["@cooler/toy.symm.upper.2.mcool"]},
    {"fn": "is_scool_file", "args": ["@work/out.scool"]}]},

  {"name": "fileops.listings.order", "op": "fileops",
   "inputs": {"tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 7}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/tiny/bins",
              "cells": [{"name": "cell10", "pixels": "@inputs/tiny/pixels"},
                        {"name": "cell2", "pixels": "@inputs/tiny/pixels"},
                        {"name": "cell1", "pixels": "@inputs/tiny/pixels"},
                        {"name": "cell20", "pixels": "@inputs/tiny/pixels"},
                        {"name": "cell3", "pixels": "@inputs/tiny/pixels"}]}],
   "calls": [
    {"fn": "list_coolers", "args": ["@work/out.scool"]},
    {"fn": "list_scool_cells", "args": ["@work/out.scool"]},
    {"fn": "list_coolers", "args": ["@cooler/toy.symm.upper.2.mcool"]},
    {"fn": "list_coolers", "args": ["@cooler/toy.symm.upper.2.cool"]},
    {"fn": "ls", "args": ["@work/out.scool"]},
    {"fn": "ls", "args": ["@work/out.scool::/cells/cell3"]},
    {"fn": "ls", "args": ["@cooler/toy.symm.upper.2.mcool::/resolutions/4"]},
    {"fn": "pprint_data_tree", "args": ["@work/out.scool", null]},
    {"fn": "pprint_data_tree", "args": ["@work/out.scool", 2]},
    {"fn": "pprint_data_tree", "args": ["@cooler/toy.symm.upper.2.cool", null]}]},

  {"name": "fileops.cp_mv_ln.same_file", "op": "fileops",
   "inputs": {"tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 40}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/tiny/bins",
              "cells": [{"name": "c1", "pixels": "@inputs/tiny/pixels"},
                        {"name": "c2", "pixels": "@inputs/tiny/pixels"}]}],
   "calls": [
    {"fn": "cp", "args": ["@work/out.scool::/cells/c1", "@work/out.scool::/copied"]},
    {"fn": "ln", "args": ["@work/out.scool::/cells/c2", "@work/out.scool::/hard"]},
    {"fn": "ln", "args": ["@work/out.scool::/cells/c2", "@work/out.scool::/soft", true]},
    {"fn": "mv", "args": ["@work/out.scool::/cells/c1", "@work/out.scool::/cells/renamed"]},
    {"fn": "ls", "args": ["@work/out.scool"]},
    {"fn": "list_coolers", "args": ["@work/out.scool"]},
    {"fn": "is_scool_file", "args": ["@work/out.scool"]}],
   "outputs": ["@work/out.scool"],
   "cross_read": ["@work/out.scool::/copied", "@work/out.scool::/cells/renamed",
                  "@work/out.scool::/hard", "@work/out.scool::/soft"]},

  {"name": "fileops.cp.across_files", "op": "fileops",
   "inputs": {"tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 40}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/tiny/bins",
              "cells": [{"name": "c1", "pixels": "@inputs/tiny/pixels"}]}],
   "calls": [
    {"fn": "cp", "args": ["@work/out.scool::/cells/c1", "@work/root.cool"]},
    {"fn": "cp", "args": ["@work/out.scool::/cells/c1", "@work/grouped.cool::/x"]},
    {"fn": "ln", "args": ["@work/out.scool::/cells/c1", "@work/linked.cool::/ext", true]},
    {"fn": "is_cooler", "args": ["@work/root.cool"]},
    {"fn": "is_cooler", "args": ["@work/grouped.cool::/x"]},
    {"fn": "list_coolers", "args": ["@work/grouped.cool"]},
    {"fn": "ls", "args": ["@work/root.cool"]}],
   "outputs": ["@work/root.cool", "@work/grouped.cool"],
   "cross_read": ["@work/root.cool", "@work/grouped.cool::/x"]},

  {"name": "fileops.err.not_hdf5_and_not_scool", "op": "fileops",
   "calls": [
    {"fn": "is_scool_file", "args": ["@cooler/toy.chrom.sizes"]},
    {"fn": "list_coolers", "args": ["@cooler/toy.chrom.sizes"]},
    {"fn": "ls", "args": ["@cooler/toy.chrom.sizes"]},
    {"fn": "list_scool_cells", "args": ["@cooler/toy.symm.upper.2.cool"]},
    {"fn": "list_scool_cells", "args": ["@cooler/toy.chrom.sizes"]},
    {"fn": "is_cooler", "args": ["@cooler/toy.symm.upper.2.mcool::/resolutions/999"]}]},

  {"name": "fileops.err.hard_link_across_files", "op": "fileops",
   "inputs": {"tiny": {"source": "@hicx/small_test_matrix_50kb_res.cool", "transforms": [{"op": "head", "n": 7}]}},
   "steps": [{"uri": "@work/out.scool", "bins": "@inputs/tiny/bins",
              "cells": [{"name": "c1", "pixels": "@inputs/tiny/pixels"}]}],
   "calls": [
    {"fn": "ln", "args": ["@work/out.scool::/cells/c1", "@work/other.cool::/h"]},
    {"fn": "cp", "args": ["@work/out.scool::/cells/c1", "@work/out.scool::/cells/c1"]},
    {"fn": "mv", "args": ["@work/out.scool::/cells/absent", "@work/out.scool::/gone"]}]}
 ]
}
