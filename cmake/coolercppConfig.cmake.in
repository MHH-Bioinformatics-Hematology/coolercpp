@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# coolercpp links HDF5 privately; a static coolercpp still needs it at link
# time, and a shared one finds it through its RPATH.
find_dependency(HDF5 COMPONENTS C)

include("${CMAKE_CURRENT_LIST_DIR}/coolercppTargets.cmake")
check_required_components(coolercpp)
